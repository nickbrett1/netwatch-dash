<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nickbrett.netwatch.lan-speed</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nick/.local/bin/netwatch</string>
		<string>lan-speed</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/nick/.local/state/netwatch/lan-speed.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/nick/.local/state/netwatch/lan-speed.log</string>
</dict>
</plist>
