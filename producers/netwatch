#!/bin/bash
# netwatch — detect LAN-path degradation (the "Mac wired into an Orbi
# satellite with wireless backhaul" failure mode) cheaply and early.
#
# The probe measures gateway RTT, a wired peer's RTT, and interface RX over
# the SAME window, then:
#   * suppresses the alarm entirely when the link is busy (our own traffic ->
#     the latency is our queueing, not a fault);
#   * alerts on packet loss on an otherwise idle link (the reliable signal);
#   * measures + logs gateway RTT but does NOT alert on it by default
#     (RTT_ALERT=off): the Orbi answers ICMP to its own address on a slow
#     control-plane path, so its RTT is all jitter and no signal;
#   * describes the link from its actual media (wired/wireless), no canned claim.
#
#   netwatch probe      cheap gateway-RTT + link check  (run every ~5 min)
#   netwatch speed       full Ookla WAN throughput test  (run daily)
#   netwatch lan-speed   iperf3 Mac<->NAS LAN throughput (run daily)
#   netwatch report [n]  show last n runs (default 20)
#   netwatch tail        live view
#
# Config: ~/.config/netwatch/config   (sourced bash; see keys below)
# Log:    ~/.local/state/netwatch/events.jsonl

set -uo pipefail

CONFIG="${NETWATCH_CONFIG:-$HOME/.config/netwatch/config}"
STATE="${NETWATCH_STATE:-$HOME/.local/state/netwatch}"
LOG="$STATE/events.jsonl"
ALERT_STATE="$STATE/.last_alert"
mkdir -p "$STATE"

# ---- defaults (override in config) --------------------------------------
GATEWAY="auto"            # or an explicit IP; "auto" reads the default route
RTT_ALERT="off"           # gateway-RTT alarms ("rtt"/"rtt-local"). "off" = log only
                          # (see ~/.config/netwatch/config for why this defaults off)
RTT_WARN_MS=4.0           # avg gateway RTT above this = degraded path (only if RTT_ALERT=on)
RTT_WARN_CONSEC=3         # ...for this many consecutive probes (persistence, not a blip)
PING_COUNT=5              # pings per probe window
NET_PEER="192.168.1.2"    # wired peer on the same switch; if it is slow too the
                          # delay is local, not the router uplink. ""/none/off disables
SAT_MBPS=100              # interface RX >= this (Mbps) => link busy => latency here is
                          # our own queueing, so suppress the alarm
SAT_LOAD=""               # optional: 1-min load avg >= this also counts as "busy" (off)
DL_WARN_MBPS=250          # WAN download below this = alert
UL_WARN_MBPS=250          # WAN upload below this = alert
SPEEDTEST_BIN=""          # path to Ookla CLI; auto-detected if empty
SPEEDTEST_SERVER_IDS=""   # Ookla server IDs to try first, in order (space/comma
                          # separated, e.g. "36817 30411"); empty = Ookla's own
                          # pick, retried on the nearest servers if it reads low
SPEEDTEST_RETRY_LOW=on    # a run below DL/UL_WARN_MBPS is confirmed on another
                          # server, and the better reading is the one kept
SPEEDTEST_MAX_RUNS=3      # hard cap on speedtest runs per `netwatch speed`
LAN_PEER=""              # far end of the daily LAN test; empty = use NET_PEER (the NAS)
LAN_PORT=5201            # iperf3 server port on LAN_PEER
LAN_DURATION=5           # seconds per direction, per LAN run
LAN_STREAMS=4            # parallel streams; one flow will not fill a gigabit
IPERF_BIN=""             # path to iperf3; auto-detected if empty
LAN_PEER_MODE="mac"      # "mac"  = run the iperf3 client here (needs a server on LAN_PEER)
                         # "peer" = run the client on LAN_PEER over ssh (needs a server here).
                         #   Use "peer" on macOS: Local Network Privacy blocks a local,
                         #   non-Apple iperf3 from reaching LAN peers -> EHOSTUNREACH.
LAN_SSH=""               # peer mode: ssh target, BatchMode/key auth, e.g. nick@192.168.1.2
LAN_SSH_PORT=22          # peer mode: ssh port
LAN_PEER_IPERF="iperf3"  # peer mode: how to invoke iperf3 there,
                         #   e.g. "sudo docker exec iperf3 iperf3"
LAN_BIND=""              # peer mode: address to bind the local server to; default = the
                         #   LAN IP of the interface that routes to LAN_PEER
NTFY_TOPIC=""             # e.g. "nick-netwatch-9f3a" -> phone push via ntfy.sh
ALERT_COOLDOWN=3600       # seconds between repeat alerts of the same kind
NOTIFY_MACOS=true         # also show a desktop notification
# -------------------------------------------------------------------------
[ -f "$CONFIG" ] && . "$CONFIG"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$STATE/netwatch.log"; }

json_escape() { python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))'; }

gw_ip() {
  if [ "$GATEWAY" != "auto" ]; then echo "$GATEWAY"; return; fi
  route -n get default 2>/dev/null | awk '/gateway/{print $2; exit}'
}

iface() { route -n get default 2>/dev/null | awk '/interface/{print $2; exit}'; }

# This Mac's own address on the interface that routes to $1 — the LAN IP the peer
# connects back to in peer mode. Falls back to the default-route interface.
lan_ip_towards() {
  local dev
  dev=$(route -n get "$1" 2>/dev/null | awk '/interface/{print $2; exit}')
  [ -n "$dev" ] || dev=$(iface)
  ipconfig getifaddr "$dev" 2>/dev/null
}

# --- alerting -------------------------------------------------------------
# alert <kind> <title> <message>
alert() {
  local kind="$1" title="$2" msg="$3" now last
  now=$(date +%s); last=0
  [ -f "$ALERT_STATE" ] && last=$(awk -v k="$kind" '$1==k{print $2}' "$ALERT_STATE" 2>/dev/null)
  last="${last:-0}"
  if [ $((now - last)) -lt "$ALERT_COOLDOWN" ]; then
    log "suppressed '$kind' alert (cooldown)"; return
  fi
  # replace/append this kind's timestamp
  touch "$ALERT_STATE.tmp"
  { grep -v "^$kind " "$ALERT_STATE" 2>/dev/null; echo "$kind $now"; } >"$ALERT_STATE.tmp" \
    && mv "$ALERT_STATE.tmp" "$ALERT_STATE"

  log "ALERT [$kind] $title — $msg"
  if [ -n "$NTFY_TOPIC" ]; then
    curl -s -m 10 -o /dev/null \
      -H "Title: $title" -H "Tags: warning,network" -H "Priority: high" \
      -d "$msg" "https://ntfy.sh/$NTFY_TOPIC" || log "ntfy send failed"
  fi
  if [ "$NOTIFY_MACOS" = true ]; then
    osascript -e "display notification $(printf '%s' "$msg" | json_escape) with title $(printf '%s' "$title" | json_escape)" 2>/dev/null
  fi
}

emit() { # emit <json-fragment>
  printf '{"ts":"%s",%s}\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >>"$LOG"
}

find_speedtest() {
  [ -n "$SPEEDTEST_BIN" ] && [ -x "$SPEEDTEST_BIN" ] && { echo "$SPEEDTEST_BIN"; return; }
  for c in "$HOME/.local/bin/speedtest" /private/tmp/ookla/speedtest /Volumes/home/speedtest/speedtest "$(command -v speedtest 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
  done
}

# --- LAN speedtest (Mac <-> NAS) ------------------------------------------
# The WAN `speed` run answers "how fast is the internet". This answers "how fast
# is my own LAN" — the switch and cable between two boxes we own — which is the
# one thing a WAN test cannot see: a renegotiated link, a bad cable or a failing
# switch port all cap the LAN while the WAN test still reads healthy.
#
# Directions are named from *this Mac's* point of view:
#   up   = this Mac sends   (iperf3 default)
#   down = this Mac receives (iperf3 -R)
#
# Two ways to run it, because the client half is what macOS gates:
#   LAN_PEER_MODE=mac   the iperf3 client runs here and LAN_PEER runs the server.
#   LAN_PEER_MODE=peer  the client runs on LAN_PEER, invoked over ssh, against a
#                       server started here. This exists because macOS *Local
#                       Network Privacy* denies a locally-run, non-Apple iperf3
#                       any connection to a LAN peer other than the default
#                       gateway (EHOSTUNREACH, "No route to host"), while the
#                       Apple ssh client and inbound connections are exempt. The
#                       peer (Linux) has no such restriction. The direction
#                       names above are unchanged either way: whichever end is
#                       this Mac, "up" is still its egress and "down" its ingress.
find_iperf() {
  [ -n "$IPERF_BIN" ] && [ -x "$IPERF_BIN" ] && { echo "$IPERF_BIN"; return; }
  for c in /opt/homebrew/bin/iperf3 /usr/local/bin/iperf3 "$(command -v iperf3 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
  done
}

# Throughput from an `iperf3 -J` document, in Mbps. $1 is the sum to read:
# `sum_sent` for the direction this Mac sends, `sum_received` for the one it
# receives. Prints nothing when the figure is absent — an unknown rate is not a
# zero, and it must never be written as one.
iperf_mbps() {
  python3 -c '
import json,sys
try:
    d=json.load(sys.stdin)
except ValueError:
    raise SystemExit(0)          # an unreadable document is an absent figure…
key=sys.argv[1]
end=d.get("end") if isinstance(d,dict) else None
s=(end or {}).get(key,{}).get("bits_per_second")
print("" if s is None else round(s/1e6,1))' "$1" 2>/dev/null
}

# One direction of the LAN test, with a single retry. iperf3 occasionally
# answers the second test with a control/error payload instead of results — the
# server still busy from the test just before — and the JSON then has no
# `sum_*` key at all. Observed on the first Mac->NAS run 2026-09-29: the
# download direction failed once immediately after the upload and succeeded on
# an identical re-run. A daily job that loses a whole day to a transient is not
# worth having, so a blank figure is retried once after a short pause; a real
# failure (no server, refused) still exhausts both attempts and reports nothing.
# Echoes the Mbps on success and nothing on failure.
iperf_dir() {  # <bin> <peer> <sum_sent|sum_received> [extra iperf3 args...]
  local bin="$1" peer="$2" sum="$3" attempt js mbps
  shift 3
  for attempt in 1 2; do
    js=$("$bin" -c "$peer" -p "$LAN_PORT" -t "$LAN_DURATION" -P "$LAN_STREAMS" "$@" -J 2>/dev/null) || js=""
    mbps=$(printf '%s' "$js" | iperf_mbps "$sum")
    if [ -n "$mbps" ]; then printf '%s' "$mbps"; return 0; fi
    [ "$attempt" = 1 ] && sleep 1
  done
  return 1
}

# One direction of the LAN test with a single retry, the client running on the
# peer over ssh (peer mode). Same retry reasoning as iperf_dir above: a blank
# figure is retried once, a real failure exhausts both attempts. $LAN_PEER_IPERF
# is the peer's own way of running iperf3 (e.g. "sudo docker exec iperf3 iperf3"),
# so the peer needs no iperf3 on its PATH. The remote command is one string parsed
# by the peer's shell, so $extra is meant to split there, not here. Echoes the
# Mbps on success and nothing on failure.
peer_iperf_dir() {  # <mac_ip> <sum_sent|sum_received> [extra iperf3 args...]
  local macip="$1" sum="$2" attempt js mbps extra
  shift 2
  extra="$*"
  for attempt in 1 2; do
    js=$(ssh -p "$LAN_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=8 "$LAN_SSH" \
      "$LAN_PEER_IPERF -c $macip -p $LAN_PORT -t $LAN_DURATION -P $LAN_STREAMS $extra -J" \
      2>/dev/null) || js=""
    mbps=$(printf '%s' "$js" | iperf_mbps "$sum")
    if [ -n "$mbps" ]; then printf '%s' "$mbps"; return 0; fi
    [ "$attempt" = 1 ] && sleep 1
  done
  return 1
}

# Peer mode: the client runs on LAN_PEER and this Mac runs the server — the
# reverse of mac mode, for the macOS Local Network Privacy case (see the top of
# this section). This Mac's iperf3 *server* is unaffected by that gate: it is on
# outbound connections, and the peer initiates here.
lan_speed_peer_mode() {
  local peer="$1" bin macip up dl srv i
  if [ -z "$LAN_SSH" ]; then
    log "lan-speed: LAN_PEER_MODE=peer but LAN_SSH is empty"
    echo "lan-speed: LAN_PEER_MODE=peer needs LAN_SSH (ssh target)" >&2; return 1
  fi
  bin=$(find_iperf)
  if [ -z "$bin" ]; then
    log "lan-speed: no local iperf3 to run the peer-mode server"
    echo "no iperf3 found (server side)" >&2; return 1
  fi
  macip="${LAN_BIND:-$(lan_ip_towards "$peer")}"
  if [ -z "$macip" ]; then
    log "lan-speed: could not determine this host's LAN IP towards $peer"
    echo "lan-speed: no local LAN IP towards $peer" >&2; return 1
  fi

  # Server here, bound to the LAN IP the peer will reach. Inbound is not gated.
  "$bin" -s -p "$LAN_PORT" -B "$macip" >/dev/null 2>&1 &
  srv=$!
  for i in $(seq 1 25); do
    lsof -nP -iTCP:"$LAN_PORT" -sTCP:LISTEN >/dev/null 2>&1 && break
    kill -0 "$srv" 2>/dev/null || break
    sleep 0.2
  done

  # The peer is the client, so its default run is the peer sending -> this Mac
  # receives ("down"); -R makes this Mac the sender ("up"). Same direction names
  # as mac mode, read off the side this Mac is on.
  dl=$(peer_iperf_dir "$macip" sum_received)
  # A brief settle so the server is idle before the reverse test starts.
  sleep 1
  up=$(peer_iperf_dir "$macip" sum_sent -R)

  kill "$srv" 2>/dev/null

  if [ -z "$up" ] || [ -z "$dl" ]; then
    log "lan-speed: peer-mode iperf3 returned no throughput (up='${up}' down='${dl}')"
    echo "iperf3 returned no throughput (peer mode: is $LAN_SSH reachable and able to run iperf3?)" >&2
    return 1
  fi
  emit "\"kind\":\"lan_speed\",\"peer\":\"$peer\",\"dl_mbps\":$dl,\"ul_mbps\":$up"
  log "lan-speed peer=$peer dl=${dl}Mbps ul=${up}Mbps mode=peer"
  echo "LAN ${peer}  DL ${dl} Mbps  UL ${up} Mbps"
}

# Mac mode (default, the original): the iperf3 client runs here and the server on
# the peer. Needs a reachable server on LAN_PEER:$LAN_PORT.
lan_speed_mac_mode() {
  local peer="$1" bin up dl
  bin=$(find_iperf)
  if [ -z "$bin" ]; then
    log "lan-speed: no iperf3 found"; echo "no iperf3 found" >&2; return 1
  fi

  # up: this Mac sends. down: the peer sends, this Mac receives (-R). Neither
  # writes anything on failure: "the test could not run" and "the link carried no
  # throughput" are different facts, and a zero record would state the second
  # (schema §6).
  up=$(iperf_dir "$bin" "$peer" sum_sent)
  # A brief settle so the server is idle before the reverse test starts (the
  # transient above happens when it is not).
  sleep 1
  dl=$(iperf_dir "$bin" "$peer" sum_received -R)

  if [ -z "$up" ] || [ -z "$dl" ]; then
    log "lan-speed: iperf3 returned no throughput (up='${up}' down='${dl}')"
    echo "iperf3 returned no throughput (is an iperf3 server on $peer:$LAN_PORT?)" >&2
    return 1
  fi

  emit "\"kind\":\"lan_speed\",\"peer\":\"$peer\",\"dl_mbps\":$dl,\"ul_mbps\":$up"
  log "lan-speed peer=$peer dl=${dl}Mbps ul=${up}Mbps mode=mac"
  echo "LAN ${peer}  DL ${dl} Mbps  UL ${up} Mbps"
}

cmd_lan_speed() {
  local peer
  peer="${LAN_PEER:-$NET_PEER}"
  case "$peer" in
    ""|none|off|no) log "lan-speed: no LAN_PEER/NET_PEER set"
      echo "lan-speed: no peer configured" >&2; return 1 ;;
  esac
  case "${LAN_PEER_MODE:-mac}" in
    mac)  lan_speed_mac_mode  "$peer" ;;
    peer) lan_speed_peer_mode "$peer" ;;
    *) log "lan-speed: unknown LAN_PEER_MODE='$LAN_PEER_MODE'"
       echo "lan-speed: unknown LAN_PEER_MODE='$LAN_PEER_MODE'" >&2; return 1 ;;
  esac
}

# --- probe ----------------------------------------------------------------
# bytes received on iface (monotonic counter, used for a throughput sample)
iface_rx() {
  netstat -ibn 2>/dev/null | awk -v d="$1" '$1==d && $3 ~ /^<Link/ {print $(NF-4); exit}'
}

cmd_probe() {
  local gw dev avg loss media consec peer peer_avg peer_loss
  local rx0 rx1 t0 t1 mbps saturated=false l1 link="wired"
  gw=$(gw_ip); dev=$(iface)
  if [ -z "$gw" ]; then log "probe: no default gateway"; return 0; fi

  # Sample window: RX byte counter + wall clock. RTT and throughput are
  # measured over the SAME window, so a busy link and a slow ping co-vary.
  t0=$(python3 -c 'import time;print("%.3f"%time.time())')
  rx0=$(iface_rx "$dev")

  local out
  out=$(ping -c "$PING_COUNT" -i 0.2 -W 2000 -t 5 "$gw" 2>/dev/null)
  avg=$(printf '%s' "$out" | awk -F'/' '/round-trip|rtt/{print $5; exit}')
  loss=$(printf '%s' "$out" | awk -F',' '/packet loss/{gsub(/[^0-9.]/,"",$3); print $3; exit}')
  avg="${avg:-0}"; loss="${loss:-100}"

  # Wired peer on the same switching fabric (default: the NAS). If it moves
  # together with the gateway the delay is local, not the path above the router.
  peer=""; peer_avg=""; peer_loss=""
  case "$NET_PEER" in
    ""|none|off|no) : ;;
    *)
      peer="$NET_PEER"
      local pout
      pout=$(ping -c "$PING_COUNT" -i 0.2 -W 2000 -t 5 "$peer" 2>/dev/null)
      peer_avg=$(printf '%s' "$pout" | awk -F'/' '/round-trip|rtt/{print $5; exit}')
      peer_loss=$(printf '%s' "$pout" | awk -F',' '/packet loss/{gsub(/[^0-9.]/,"",$3); print $3; exit}')
      peer_avg="${peer_avg:-}"
      ;;
  esac

  t1=$(python3 -c 'import time;print("%.3f"%time.time())')
  rx1=$(iface_rx "$dev")

  mbps=""
  if [ -n "$rx0" ] && [ -n "$rx1" ]; then
    mbps=$(awk -v a="$rx1" -v b="$rx0" -v s="$t0" -v e="$t1" \
      'BEGIN{ if (e>s) printf "%.1f", (a-b)*8/1e6/(e-s) }')
  fi

  # Is the link busy (our own traffic)?  -> latency here is queueing, not a fault
  if [ -n "$mbps" ] && awk -v m="$mbps" -v t="$SAT_MBPS" 'BEGIN{exit !(m>=t)}'; then
    saturated=true
  fi
  if [ "$saturated" = false ] && [ -n "$SAT_LOAD" ]; then
    l1=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
    [ -n "$l1" ] && awk -v a="$l1" -v t="$SAT_LOAD" 'BEGIN{exit !(a>=t)}' && saturated=true
  fi

  media=""
  [ -n "$dev" ] && media=$(ifconfig "$dev" 2>/dev/null \
    | awk -F'media: ' '/media:/{print $2; exit}' \
    | sed -E 's/.*\((.*)\).*/\1/; s/[<>]//g; s/,/ /g' | cut -c1-40)
  printf '%s' "$media" | grep -qiE '802\.11|wi-?fi|wireless' && link="wireless"

  # ---- emit + log -------------------------------------------------------
  local frag="\"kind\":\"probe\",\"gw\":\"$gw\",\"iface\":\"$dev\",\"rtt_ms\":$avg,\"loss_pct\":${loss:-100},\"media\":\"${media}\",\"link\":\"${link}\""
  [ -n "$mbps" ] && frag="$frag,\"rx_mbps\":$mbps,\"saturated\":$saturated"
  if [ -n "$peer" ] && [ -n "$peer_avg" ]; then
    frag="$frag,\"peer\":\"$peer\",\"peer_ms\":$peer_avg,\"peer_loss_pct\":${peer_loss:-100}"
  fi
  emit "$frag"
  local satnote=""
  [ "$saturated" = true ] && satnote=" SATURATED"
  log "probe gw=$gw dev=$dev rtt=${avg}ms loss=${loss}% media=$media${peer:+ peer=${peer_avg}ms/${peer_loss}%}${mbps:+ rx=${mbps}Mbps}${satnote}"

  # ---- alerting ---------------------------------------------------------

  # 1) busy link: latency/loss is our own queueing -> never alert, reset streak.
  if [ "$saturated" = true ]; then
    echo 0 >"$STATE/.rtt_streak"
    if awk -v a="$avg" -v t="$RTT_WARN_MS" 'BEGIN{exit !(a>t)}' \
       || awk -v l="${loss:-100}" 'BEGIN{exit !(l>0)}'; then
      log "probe: link saturated (${mbps}Mbps, rtt ${avg}ms, loss ${loss}%) — latency/loss alarm suppressed"
    fi
    return 0
  fi

  # 2) loss on a non-busy link is worth an immediate alert.
  if awk -v l="${loss:-100}" 'BEGIN{exit !(l>0)}'; then
    alert "loss" "Packet loss to gateway" \
      "${loss}% loss to ${gw} on ${dev} [${media}]${peer:+; peer ${peer} ${peer_loss}%}"
  fi

  # 3) sustained high gateway RTT — only when RTT_ALERT=on. Off by default:
  #    the Orbi answers ICMP to its own address on a slow control-plane path
  #    (floor ~1.75 ms, spikes to ~76 ms, 0% loss, forwarded traffic healthy),
  #    so RTT is logged to events.jsonl but is not treated as a health signal.
  if [ "${RTT_ALERT:-off}" != off ] && awk -v a="$avg" -v t="$RTT_WARN_MS" 'BEGIN{exit !(a>t)}'; then
    consec=0
    [ -f "$STATE/.rtt_streak" ] && consec=$(cat "$STATE/.rtt_streak")
    consec=$((consec + 1)); echo "$consec" >"$STATE/.rtt_streak"
    if [ "$consec" -ge "$RTT_WARN_CONSEC" ]; then
      if [ -n "$peer_avg" ] && awk -v a="$peer_avg" -v t="$RTT_WARN_MS" 'BEGIN{exit !(a>t)}'; then
        alert "rtt-local" "Local link path degraded" \
          "Gateway ${gw} ${avg}ms and wired peer ${peer} ${peer_avg}ms both >${RTT_WARN_MS}ms (x${consec}) on ${dev} [${media}] — delay is local (segment/host), not the router uplink"
      else
        alert "rtt" "Network path degraded" \
          "Gateway ${gw} RTT ${avg}ms (>${RTT_WARN_MS}ms x${consec}) on ${dev} [${media}${peer:+; wired peer ${peer} stayed ${peer_avg}ms}] — delay is at/above the router, link is ${link}"
      fi
    fi
  else
    echo 0 >"$STATE/.rtt_streak"
  fi
}

# --- speedtest ------------------------------------------------------------
# A throughput reading is only as good as the server it came from, and Ookla's
# auto-selection is not stable. On 2026-10-02 and 2026-10-04 the daily run
# landed on one New York server whose upload side read ~150 Mbps while every
# other server read ~540; the link itself was fine (a hand re-run minutes later
# gave 509/562, and the Mac<->NAS iperf3 read 913/893 in the same window). A
# single degraded test server must not colour the dashboard, so a reading below
# the warn threshold is confirmed against a different server and the better run
# wins. The emitted event is unchanged: it still names the one server whose
# numbers it carries.
#
#   SPEEDTEST_SERVER_IDS=""   server IDs to try first, in order (space/comma
#                             separated); empty = Ookla's own pick, then the
#                             nearest servers
#   SPEEDTEST_RETRY_LOW=on    confirm a below-threshold run on another server
#   SPEEDTEST_MAX_RUNS=3      hard cap on runs per invocation

# The nearest server IDs, closest first, from `speedtest -L`.
speedtest_servers() {  # <bin>
  "$1" -L 2>/dev/null | awk '$1 ~ /^[0-9]+$/ {print $1}'
}

# One run. Prints "<dl> <ul> <ping> <server-id> <server-json>" or returns non-zero.
speedtest_run() {  # <bin> [<server-id>]
  local js
  if [ -n "${2:-}" ]; then js=$("$1" -s "$2" -f json 2>/dev/null)
  else js=$("$1" -f json 2>/dev/null); fi
  [ -n "$js" ] || return 1
  printf '%s' "$js" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print(round(d["download"]["bandwidth"]*8/1e6,1),
      round(d["upload"]["bandwidth"]*8/1e6,1),
      round(d["ping"]["latency"],1),
      d["server"].get("id",""),
      json.dumps(d["server"]["name"]+" "+d["server"]["location"]))'
}

# A reading is low if either direction is below its threshold; a missing
# threshold skips that direction (never a comparison against zero).
speedtest_low() {  # <dl> <ul>
  if [ -n "$DL_WARN_MBPS" ] && awk -v x="$1" -v t="$DL_WARN_MBPS" 'BEGIN{exit !(x<t)}'; then return 0; fi
  if [ -n "$UL_WARN_MBPS" ] && awk -v x="$2" -v t="$UL_WARN_MBPS" 'BEGIN{exit !(x<t)}'; then return 0; fi
  return 1
}

# Is <dl> <ul> a better reading than <dl2> <ul2>? Judged on the weaker
# direction, so a run with a fine download and a bad upload cannot win on the
# strength of the direction that was never in doubt.
speedtest_better() {  # <dl> <ul> <dl2> <ul2>
  awk -v a1="$1" -v a2="$2" -v b1="$3" -v b2="$4" \
    'BEGIN{amin=a1<a2?a1:a2; bmin=b1<b2?b1:b2; exit !(amin>bmin)}'
}

cmd_speed() {
  local st ids cand want dl ul ping sid srv used n maxruns best_dl best_ul best_ping best_srv
  st=$(find_speedtest)
  if [ -z "$st" ]; then log "speed: no Ookla CLI found"; echo "no Ookla CLI found" >&2; return 1; fi

  maxruns=${SPEEDTEST_MAX_RUNS:-3}
  case "$maxruns" in ''|*[!0-9]*|0) maxruns=1 ;; esac
  case "${SPEEDTEST_RETRY_LOW:-on}" in off|no|false|0) maxruns=1 ;; esac

  # What to try, in order. Configured servers win; with none configured the
  # first run is Ookla's own pick and the rest are the nearest servers, which is
  # where a retry lands when that pick is a bad one.
  ids=$(printf '%s' "${SPEEDTEST_SERVER_IDS:-auto}" | tr ',\t' '  ')
  cand="$ids"
  case " $ids " in
    *" auto "*)
      # No configured servers: Ookla picks the first, and the other attempts
      # (only worth asking for when retries are enabled at all) fall back to the
      # nearest servers — which is where a retry lands when auto picks badly.
      if [ "$maxruns" -gt 1 ]; then
        cand="auto $(speedtest_servers "$st" | head -n $((maxruns - 1)) | tr '\n' ' ')"
      fi ;;
  esac

  used=" "; n=0; best_dl=""; best_ul=""; best_ping=""; best_srv=""
  for want in $cand; do
    [ "$n" -lt "$maxruns" ] || break
    case "$used" in *" $want "*) continue ;; esac
    n=$((n + 1))
    [ "$want" = auto ] && want=""
    if ! read -r dl ul ping sid srv < <(speedtest_run "$st" "$want"); then
      log "speed: run ${n} failed"; continue
    fi
    used="$used${want:-$sid} "
    log "speed run ${n}: dl=${dl}Mbps ul=${ul}Mbps ping=${ping}ms srv=$srv"
    if [ -z "$best_dl" ] || speedtest_better "$dl" "$ul" "$best_dl" "$best_ul"; then
      best_dl=$dl; best_ul=$ul; best_ping=$ping; best_srv=$srv
    fi
    speedtest_low "$dl" "$ul" || break   # healthy: no reason to spend another run
  done

  if [ -z "$best_dl" ]; then
    log "speed: speedtest failed"; echo "speedtest failed" >&2; return 1
  fi

  emit "\"kind\":\"speed\",\"dl_mbps\":$best_dl,\"ul_mbps\":$best_ul,\"ping_ms\":$best_ping,\"server\":$best_srv"
  log "speed dl=${best_dl}Mbps ul=${best_ul}Mbps ping=${best_ping}ms srv=$best_srv"

  if [ -n "$DL_WARN_MBPS" ] && awk -v d="$best_dl" -v t="$DL_WARN_MBPS" 'BEGIN{exit !(d<t)}'; then
    alert "dl" "WAN downlink low" "Download ${best_dl} Mbps (<${DL_WARN_MBPS}) via $best_srv"
  fi
  if [ -n "$UL_WARN_MBPS" ] && awk -v u="$best_ul" -v t="$UL_WARN_MBPS" 'BEGIN{exit !(u<t)}'; then
    alert "ul" "WAN uplink low" "Upload ${best_ul} Mbps (<${UL_WARN_MBPS}) via $best_srv"
  fi
  echo "DL ${best_dl} Mbps  UL ${best_ul} Mbps  ping ${best_ping} ms  ($best_srv)"
}

# --- reporting ------------------------------------------------------------
cmd_report() {
  local n="${1:-20}"
  [ -f "$LOG" ] || { echo "no events yet ($LOG)"; return; }
  python3 - "$LOG" "$n" <<'EOF'
import json,sys
path,n=sys.argv[1],int(sys.argv[2])
with open(path) as f:
    rows=[json.loads(l) for l in f if l.strip()][-n:]
for r in rows:
    t=r["ts"][11:19]
    if r["kind"]=="probe":
        sat=r.get("saturated",False)
        flag="  <-- LOSS" if ((r.get("loss_pct") or 0)>0 and not sat) else ""
        extra=""
        if r.get("peer_ms") is not None: extra+=f"  peer {r['peer_ms']}ms"
        if r.get("rx_mbps") is not None: extra+=f"  rx {r['rx_mbps']}Mbps" + (" [SATURATED]" if sat else "")
        print(f"{t}  probe   rtt {r.get('rtt_ms'):>6} ms  loss {r.get('loss_pct')}%  {r.get('iface')} {r.get('media','')}{extra}{flag}")
    elif r["kind"]=="lan_speed":
        print(f"{t}  lan     DL {r.get('dl_mbps'):>6}  UL {r.get('ul_mbps'):>6} Mbps  peer {r.get('peer')}")
    else:
        print(f"{t}  speed   DL {r.get('dl_mbps'):>6}  UL {r.get('ul_mbps'):>6} Mbps  ping {r.get('ping_ms')} ms  {r.get('server')}")
probes=[r for r in rows if r["kind"]=="probe"]
speeds=[r for r in rows if r["kind"]=="speed"]
lans=[r for r in rows if r["kind"]=="lan_speed"]
if probes:
    rs=[p["rtt_ms"] for p in probes]
    print(f"\nprobe: {len(probes)} runs, rtt min/avg/max {min(rs):.2f}/{sum(rs)/len(rs):.2f}/{max(rs):.2f} ms")
if speeds:
    d=[s["dl_mbps"] for s in speeds]; u=[s["ul_mbps"] for s in speeds]
    print(f"speed: {len(speeds)} runs, DL {min(d)}-{max(d)} Mbps, UL {min(u)}-{max(u)} Mbps")
if lans:
    d=[s["dl_mbps"] for s in lans]; u=[s["ul_mbps"] for s in lans]
    print(f"lan:   {len(lans)} runs, DL {min(d)}-{max(d)} Mbps, UL {min(u)}-{max(u)} Mbps")
EOF
}

case "${1:-probe}" in
  probe)     cmd_probe ;;
  speed)     cmd_speed ;;
  lan-speed) cmd_lan_speed ;;
  report)    shift; cmd_report "$@" ;;
  tail)      tail -f "$LOG" ;;
  *) echo "usage: netwatch {probe|speed|lan-speed|report [n]|tail}" >&2; exit 2 ;;
esac
